<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurant.inventory.controller.MenuController"
            styleClass="page-menu">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <top>
        <VBox spacing="8">
            <Label fx:id="todaysDiscountLabel" styleClass="discount-banner" wrapText="true" maxWidth="Infinity"/>

            <!-- Live weather (Open-Meteo API) + weather deal -->
            <VBox styleClass="weather-card" spacing="5">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="weatherTitleLabel" styleClass="weather-title" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="refreshWeatherButton" text="Refresh weather" onAction="#onRefreshWeather"/>
                </HBox>
                <Label fx:id="weatherDetailsLabel" wrapText="true"/>
                <Label fx:id="weatherOfferLabel" styleClass="weather-offer" wrapText="true"/>
                <FlowPane fx:id="weatherPicksPane" hgap="8" vgap="6"/>
            </VBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="6" prefWidth="300">
            <Label text="Menu categories (TreeView)" styleClass="section-title"/>
            <TreeView fx:id="menuTree" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets left="20"/>
            </padding>
            <Label fx:id="selectedNodeLabel" styleClass="section-title" wrapText="true"/>
            <Label fx:id="detailsLabel" styleClass="dish-details" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
