<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.restaurant.inventory.controller.OrderController"
            styleClass="page-orders">
    <padding>
        <Insets top="12" right="12" bottom="8" left="12"/>
    </padding>

    <top>
        <VBox spacing="8">
            <Label fx:id="todaysDiscountLabel" styleClass="discount-banner" wrapText="true" maxWidth="Infinity"/>
            <!-- filled from Java code: TextField (Enter key) + Buttons -->
            <HBox fx:id="quickBar" spacing="10" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="6" bottom="4"/>
                </padding>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="6" prefWidth="290">
            <Label text="Menu (ListView) - colour coded by category" styleClass="section-title" wrapText="true"/>
            <ListView fx:id="dishList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="transparent-scroll">
            <content>
                <VBox spacing="8" alignment="TOP_CENTER">
                    <padding>
                        <Insets left="14" right="14"/>
                    </padding>
                    <StackPane fx:id="dishImageFrame" styleClass="dish-frame">
                        <ImageView fx:id="dishImage" fitWidth="300" fitHeight="190" preserveRatio="true"/>
                    </StackPane>
                    <Button text="Reset Image" onAction="#onChangeImage"/>
                    <Label fx:id="selectedDishLabel" styleClass="section-title" wrapText="true"/>

                    <Label text="Ingredients needed" styleClass="field-label"/>
                    <TableView fx:id="recipeTable" prefHeight="150">
                        <columns>
                            <TableColumn fx:id="recIngredientCol" text="Ingredient" prefWidth="150"/>
                            <TableColumn fx:id="recNeededCol" text="Needed" prefWidth="100"/>
                            <TableColumn fx:id="recInStockCol" text="In stock" prefWidth="100"/>
                            <TableColumn fx:id="recStatusCol" text="Status" prefWidth="110"/>
                        </columns>
                    </TableView>

                    <!-- the "Add Selected to Cart" Button is added here from Java code -->
                    <HBox fx:id="actionBar" spacing="10" alignment="CENTER_LEFT">
                        <Label text="Quantity (1-10):" styleClass="field-label"/>
                        <Spinner fx:id="qtySpinner" prefWidth="90"/>
                    </HBox>

                    <Label fx:id="orderSummaryLabel" wrapText="true"/>

                    <!-- ===================== CART: order several dishes by name ===================== -->
                    <TitledPane text="Your Cart - order multiple dishes by name" collapsible="false" styleClass="cart-pane">
                        <content>
                            <VBox spacing="8">
                                <padding>
                                    <Insets top="8" right="8" bottom="8" left="8"/>
                                </padding>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label text="Order by name:" styleClass="field-label"/>
                                    <TextField fx:id="addToCartField" promptText="e.g. Sushi Platter, mango, tacos..." prefWidth="240"/>
                                    <Button text="Add to Cart" styleClass="primary-button" onAction="#onAddToCart"/>
                                </HBox>

                                <TableView fx:id="cartTable" prefHeight="150">
                                    <columns>
                                        <TableColumn fx:id="cartDishCol" text="Dish" prefWidth="200"/>
                                        <TableColumn fx:id="cartQtyCol" text="Qty" prefWidth="60"/>
                                        <TableColumn fx:id="cartPriceCol" text="Unit price" prefWidth="130"/>
                                        <TableColumn fx:id="cartLineTotalCol" text="Line total" prefWidth="120"/>
                                    </columns>
                                </TableView>

                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Button text="Remove line" onAction="#onRemoveCartLine"/>
                                    <Button text="Clear cart" onAction="#onClearCart"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="Place Order (Checkout)" styleClass="checkout-button" onAction="#onPlaceAllOrders"/>
                                </HBox>
                                <Label fx:id="cartTotalLabel" styleClass="cart-total-label"/>
                            </VBox>
                        </content>
                    </TitledPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <right>
        <VBox spacing="6" prefWidth="250">
            <Label text="Order history" styleClass="section-title"/>
            <ListView fx:id="historyList" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>

    <bottom>
        <VBox spacing="2">
            <Label fx:id="revenueLabel" styleClass="revenue-label"/>
            <Label fx:id="stockAlertLabel" styleClass="alert-label" wrapText="true"/>
        </VBox>
    </bottom>
</BorderPane>
