<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.restaurant.inventory.controller.MainController"
            stylesheets="/css/styles.css" styleClass="main-pane"
            xmlns:fx="http://javafx.com/fxml">
    <left>
        <VBox spacing="12" style="-fx-background-color: #2c3e50; -fx-padding: 15px;" prefWidth="200">
            <Label text="Restaurant POS" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region prefHeight="10"/>
            <Button text="Menu" prefWidth="170" styleClass="button"/>
            <Button text="Orders" prefWidth="170" styleClass="button"/>
            <Button text="Inventory" prefWidth="170" styleClass="button"/>
            <Button text="Staff" prefWidth="170" styleClass="button"/>
            <Button text="Tools" prefWidth="170" styleClass="button"/>
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentArea"/>
    </center>
</BorderPane>