<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.restaurant.inventory.controller.InventoryController"
            stylesheets="/css/styles.css" styleClass="inventory-pane"
            xmlns:fx="http://javafx.com/fxml">
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="Inventory &amp; Stock Levels" styleClass="header-label"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets top="10" right="15" bottom="15" left="15"/></padding>
            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="itemNameCol" text="Ingredient / Item Name" prefWidth="280"/>
                    <TableColumn fx:id="quantityCol" text="Available Stock" prefWidth="160"/>
                    <TableColumn fx:id="unitCol" text="Unit" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>