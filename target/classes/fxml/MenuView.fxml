<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.restaurant.inventory.controller.MenuController"
            stylesheets="/css/styles.css" styleClass="menu-pane"
            xmlns:fx="http://javafx.com/fxml">
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="Restaurant Menu &amp; Categories" styleClass="header-label"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="Filter Category:" style="-fx-font-weight: bold;"/>
            <ComboBox fx:id="categoryFilter" prefWidth="160"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <TilePane fx:id="menuTilePane" hgap="20" vgap="20" prefColumns="4">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                </TilePane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>