<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.restaurant.inventory.controller.StaffController"
            stylesheets="/css/styles.css" styleClass="staff-pane"
            xmlns:fx="http://javafx.com/fxml">
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="Staff Directory &amp; Roles" styleClass="header-label"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10">
            <padding><Insets top="10" right="15" bottom="15" left="15"/></padding>
            <ListView fx:id="staffListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </center>
</BorderPane>