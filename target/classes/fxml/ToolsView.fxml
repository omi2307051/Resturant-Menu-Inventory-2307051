<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.restaurant.inventory.controller.ToolsController"
            stylesheets="/css/styles.css" styleClass="tools-pane"
            xmlns:fx="http://javafx.com/fxml">
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="System Tools &amp; Administration" styleClass="header-label"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Administrative Database Tools" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Button text="Export Inventory Report (.CSV)" styleClass="button"/>
            <Button text="Clear Cache &amp; Refresh Data" styleClass="button"/>
        </VBox>
    </center>
</BorderPane>