<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:controller="com.restaurant.inventory.controller.OrderController"
            stylesheets="/css/styles.css" styleClass="order-pane"
            xmlns:fx="http://javafx.com/fxml">
    <top>
        <VBox spacing="5">
            <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>
            <Label text="Customer Order Management" styleClass="header-label"/>
            <Label fx:id="discountNoticeLabel" style="-fx-text-fill: #27ae60; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="20">
            <padding><Insets top="10" right="15" bottom="15" left="15"/></padding>
            <!-- Left Side: Order Controls -->
            <VBox spacing="12" prefWidth="320">
                <Label text="Customer Name:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="customerNameField" promptText="Enter customer name"/>

                <Label text="Select Food Item:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="itemSelectorComboBox" prefWidth="300" promptText="Choose dish..."/>

                <Label text="Quantity:" style="-fx-font-weight: bold;"/>
                <Spinner fx:id="quantitySpinner" editable="true" prefWidth="150"/>

                <Region prefHeight="15"/>
                <Button text="Add Item to Order" onAction="#handleAddMoreItem" styleClass="accent-button" prefWidth="300"/>
            </VBox>

            <!-- Right Side: Summary & Checkout -->
            <VBox spacing="10" HBox.hgrow="ALWAYS">
                <Label text="Current Order Items" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                <ListView fx:id="orderSummaryListView" VBox.vgrow="ALWAYS"/>

                <Label fx:id="totalAmountLabel" text="Subtotal: ৳0.00 | Discount: -৳0.00 | Final: ৳0.00"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <Button text="Checkout &amp; Print Receipt" onAction="#handleCheckoutOrder" styleClass="button" prefWidth="240"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>